// ============================================================
//  nextflow.config  -  Pipeline Configuration
//
//  Profiles:
//    clinical     : max accuracy, BQSR on, DeepVariant accurate
//    production   : max throughput, BQSR off, fast callers
//    test         : minimal resources for CI testing
//
//  LSF executor with:
//    - perJobMemLimit: passes -M and rusage[mem=] to bsub
//    - submitRateLimit: prevents scheduler flooding
//    - Memory escalation on retry
// ============================================================

// -- Global Nextflow settings ----------------------------------
nextflow.enable.dsl         = 2
nextflow.enable.moduleBinaries = true

manifest {
    name        = 'exome-pipeline'
    author      = 'Pankaj Chauhan'
    homePage    = 'https://github.com/chauhan2987/PAPIO'
    description = 'Production-grade WES/WGS pipeline for academic cancer center'
    mainScript  = 'main.nf'
    version     = '1.0.0'
    nextflowVersion = '>=26.04.1'
}

// -- Default parameters ----------------------------------------
params {
    // -- Required (must be set in project.config) --------------
    pipeline_root      = null
    work_root          = null
    ref_index_dir      = null   // Directory containing all bwa-mem2 index files + ref FASTA
    fastq_root         = null
    container_dir      = null
    samplesheet        = null     // optional: overrides dna_/rna_samplesheet (a warning is printed)
    dna_samplesheet    = null
    rna_samplesheet    = null
    ref_fasta          = null
    ref_fai            = null
    ref_dict           = null
    dbsnp              = null
    outdir             = null
    scatter_intervals  = null   // Directory of N interval files for scatter
    input_bam_dir      = null   // Staged BAM/CRAM inputs when start_at != 'mapping' (e.g. fastquorum consensus BAMs)
    input_vcf_dir      = null   // Staged VCF inputs when start_at == 'annotation'
    input_annot_dir    = null    // Staged annotated VCF inputs when start_at == 'classification' (e.g. Result/08_annotated)

    // -- Assay + analysis type ---------------------------------
    assay              = 'wes'        // wes | wgs | rna
    analysis           = 'germline'   // germline | somatic | tumor_only | rna_fusion
    start_at           = 'mapping'
    stop_at            = 'classification'

    // -- Optional feature flags --------------------------------
    bqsr               = false    // Off by default; enable for somatic
    skip_trimming      = false    // Enable only for pre-trimmed input
    preflight_references = true   // check reference .dict vs resource VCFs / capture BED (build + chr naming) at start
    make_cram          = false    // archive dedup/BQSR BAMs as CRAM (storage only)

    // -- Cohort-scale tuning (override per run; defaults preserve current behaviour) --
    //   At 1000s of samples the scheduler window, not the per-task code, is the
    //   binding constraint. Raise these to match what your LSF admin allows;
    //   they are executor-level and do NOT affect task hashes (resume-safe).
    detailed_reports   = false    // timeline + dag HTML (heavy at scale; off by default)
    lsf_queue_size       = 500    // max concurrent LSF jobs (was hard-coded 500)
    lsf_submit_rate      = '50/1min'  // job submission rate (was hard-coded 50/1min)

    // -- Deep-coverage handling (600-800X / ~1B-read samples) - TRACE-CALIBRATED --
    //   Observed peaks (one deep tumor, BG006128_T): METRICS needed 126 GB to
    //   pass (Picard mmap, vmem ~131 GB, exit 140 at 42/84 GB); MERGE_AND_MARKDUP
    //   peaked ~96 GB RSS; bwa-mem2 alignment ~28 GB RSS flat (index-bound);
    //   Mutect2 ~5 GB RSS / ~53 GB vmem. All deep needs fit under the 180 GB
    //   common-pool cap, so bignode is a safety valve only (not required here).
    //   METRICS is sized per-sample in its process body (BAM-size proxy); markdup
    //   and alignment are sized flat in the labels below. CALIBRATE if depths grow.
    deep_input_gb       = 50      // input BAM (GB) above which METRICS uses the deep memory tier
    big_mem_ceiling_gb  = 170     // per-task ceiling for the common pool (< 180 GB cap)

    // -- Deduplication mode -------------------------------------
    //   umi_consensus : fgbio single-strand consensus (ideal for FFPE/UMI)
    //   umi_markdup   : UMI-aware Picard MarkDuplicates (BARCODE_TAG=RX)
    //   markdup       : coordinate dedup, UMI discarded (matches legacy/paper)
    dedup_mode             = 'umi_consensus'
    umi_read_structure     = '3M2S+T'  // per-mate: 3bp UMI, 2bp linker skip, rest template
    umi_read_structure_r2  = null      // R2 structure if it differs from R1 (e.g. '+T' for UMI on R1 only); null = same as R1
    consensus_min_reads    = 1         // min reads per UMI family to emit a consensus
    consensus_error_rate_pre  = 45     // fgbio phred-scaled pre-UMI error rate
    consensus_error_rate_post = 30     // fgbio phred-scaled post-UMI error rate
    consensus_max_read_error  = 0.05   // FilterConsensusReads: max mean per-read error rate
    consensus_min_base_quality = 20    // FilterConsensusReads: mask consensus bases below this Q

    // -- WES-specific ------------------------------------------
    interval_bed         = null     // Capture kit BED (required for WES)
    wes_interval_padding = 100      // bp added around WES targets for germline genotyping (GenotypeGVCFs -ip, DeepVariant regions)
    call_regions_gz      = null     // Pre-bgzipped+tabixed BED (.bed.gz) for Manta/Strelka SV calling; prepared once outside the pipeline. .tbi derived as <gz>.tbi
    // interval_list     = null     // (deprecated single-file; use bait+target below)
    bait_interval_list   = null   // Picard .interval_list of PROBES (HsMetrics BAIT)
    target_interval_list = null   // Picard .interval_list of TARGETS (HsMetrics TARGET)

    // -- WGS-specific ------------------------------------------
    mosdepth_wgs_window = 500         // WGS mosdepth window size (bp) for --by regions

    // -- Reportable-gene coverage (per-gene %>=10/20/30/50/100x; WES + WGS) --
    coverage_report_bed      = null   // BED of reportable genes/exons, col4 = gene symbol; null = skipped
    coverage_report_min_mapq = 20     // MAPQ floor for the per-gene (usable) coverage

    // -- Extra Picard QC in the same CollectMultipleMetrics pass --
    picard_extra_metrics     = true   // CollectGcBiasMetrics + CollectSequencingArtifactMetrics (needs Rscript in the GATK image for the GC PDF)

    // -- Reference resources -----------------------------------
    mills              = null     // Mills and 1000G gold standard indels
    known_indels       = null     // 1000G phase 1 known indels
    germline_resource  = null     // gnomAD AF-only VCF (Mutect2)
    panel_of_normals   = null     // Mutect2 PON VCF

    // -- Somatic filtering (contamination + orientation bias) --
    orientation_bias   = true     // FFPE: model C>T/G>A artifacts (Mutect2 f1r2 - ob-priors)
    pileup_variants    = null     // common biallelic germline SNP VCF for contamination (+ .tbi); skipped if null

    // -- Sample-swap detection -------------------------
    somalier_sites     = null     // somalier sites VCF; cohort relatedness check skipped if null
    somalier_min_relatedness = 0.90  // same-patient T/N pairs below this - possible swap
    somalier_max_unrelated   = 0.20   // different-patient pairs above this - possible duplicate/contamination

    // -- SEQUENZA (LOH + allele-specific CN + purity/ploidy) --
    sequenza_chroms         = null
    sequenza_gc_wiggle      = null
    sequenza_window         = 50
    sequenza_gamma          = 80
    sequenza_kmin           = 10
    sequenza_assembly       = 'hg38'
    sequenza_parallel       = 4
    gene_bed                = null

    // ============================================================
    //  CLINICAL-GRADE COMPONENTS (all OFF by default - additive)
    // ============================================================

    // -- soft QC gate (report-only, never halts) --
    qc_gate              = true   // master toggle: run QC_GATE (report-only)
    qc_min_mean_coverage = 100     // WARN if on-target mean depth below this
    qc_max_contamination = 0.03    // WARN if VerifyBamID2 FREEMIX above this
    qc_min_mean_coverage_normal     = null  // WES normals; null = use qc_min_mean_coverage
    qc_wgs_min_mean_coverage_tumor  = 60    // WGS tumour mean-coverage floor
    qc_wgs_min_mean_coverage_normal = 30    // WGS normal mean-coverage floor
    somalier_max_ibs0_frac          = 0.02  // same-patient pair, low relatedness but IBS0/n <= this -> LOH-compatible REVIEW, not SWAP (calibrate on known pairs)
    qc_min_mapping_rate  = 0.95    // WARN if mapped/total below this (samtools stats)
    qc_max_fold80        = 3.0     // WARN if FOLD_80_BASE_PENALTY above this (HsMetrics uniformity; WES)
    qc_min_pct_target_30x = 0.90
    qc_min_on_target      = 0.50
    
    sex_female_min_xratio = 0.80   // chrX/autosome depth >= this is female (~1.0)
    sex_male_max_xratio   = 0.65   // chrX/autosome depth <= this is male (~0.5)

    // -- somatic variant-level filtering --
    somatic_variant_filter  = true    // master toggle: run FILTER_SOMATIC_VCF
    somatic_filter_mode     = 'tag'   // 'tag' = label failures (keep all); 'remove' = drop
    filter_min_tumor_vaf    = 0.05    // min tumor VAF (AMP/CAP common LOD)
    filter_min_tumor_alt_ad = 3       // min tumor alt-supporting reads
    filter_min_tumor_dp     = 20      // min tumor total depth at site
    filter_max_normal_vaf   = 0.01    // max VAF allowed in matched normal (tumor-in-normal)
    filter_min_normal_alt_fail = 2    // somatic filter: normal VAF rejects a call only with >= this many normal alt reads

    // -- Germline Caller selection -----------------------------
    germline_caller    = 'haplotypecaller'  // haplotypecaller | deepvariant
    germline_filter    = 'nv'   // nv (single-sample NVScoreVariants) | vqsr (joint cohort). vqsr needs a large cohort to train.
    vqsr_min_samples   = 30      // minimum samples before VQSR is allowed (else use 'nv')
    germline_scatter_intervals = null

    // -- Germline gCNV resources -------------------------------
    run_gcnv               = true   // Enable germline gCNV (needs >=30 normals)
    rna_use_ctat_reference = true   // RNA arm uses ctat_lib/ref_genome.fa + ref_annot.gtf everywhere (matches the STAR index)
    germline_report_genes  = null   // reportable genes for germline LoF (one symbol per line); unioned with CGC GERMLINE genes
    germline_ba1_af        = 0.05   // germline classification: population AF above this = BENIGN_OR_LIKELY (ACMG BA1)
    germline_lof_max_af    = 0.01   // germline LoF reported only below this population MAX_AF
    germline_on_normals    = false  // somatic runs: also call germline on matched normals. OPT-IN: enable only if consent covers germline analysis
    gcnv_in_somatic        = false  // somatic runs: also run gCNV on normals (needs >= gcnv_min_samples normals)
    gcnv_min_samples       = 30      // Minimum normals for valid cohort model

    // Large-cohort joint genotyping (gnomAD-style)
    joint_genotyper  = 'classic'     // 'gnarly' (Reblock+GnarlyGenotyper, scalable) | 'classic' (GenotypeGVCFs)
    reblock_gvcf           = true   // reblock GVCFs even on the classic GenotypeGVCFs path (gnarly always reblocks)
    reblock_gq_bands       = '20'         // ReblockGVCF -GQB single-band threshold

    preprocessed_intervals = null    // GATK PreprocessIntervals output
    contig_ploidy_priors   = null    // Contig ploidy priors TSV
    gcnv_scatter_intervals = null    // Dir of interval shards for gCNV scatter
    gcnv_annotated_intervals = null  // GATK AnnotateIntervals TSV (GC-content) for gCNV GC-bias correction; optional


    // -- variant-type-aware ensemble consensus --
    // -- Ensemble consensus (Component 2) -----------------------
    somatic_consensus          = true    // master toggle: use ENSEMBLE_CONSENSUS
    consensus_filter_mode      = 'tag'   // 'remove' = keep only >=N-caller variants; 'tag' = keep all, label sub-threshold LOWCONSENSUS
    use_muse_in_consensus      = true    // MuSE (SNV only)
    use_strelka2_in_consensus  = true    // Strelka2 (SNV+indel) 
    use_varscan_in_consensus   = true    // VarScan (SNV+indel) 
    varscan_min_coverage       = 8
    varscan_min_var_freq       = 0.05
    varscan_somatic_pvalue     = 0.05
    consensus_min_snv_callers  = 2       // SNV must be called by >= N callers
    consensus_min_indel_callers= 2       // indel must be called by >= N callers
    muse_exclude_tier          = 'Tier5' // MuSE tier to drop (keep Tier1-4 + PASS)

    // -- Tumor Mutational Burden (TMB) ------------------
    compute_tmb         = true   // master toggle: run COMPUTE_TMB
    tmb_cutoff          = 10      // mut/Mb threshold for TMB-High (FDA/KEYNOTE-158)
    tmb_include_splice  = false   // include splice_acceptor/donor in nonsynonymous count
    tmb_coding_bed      = null    // CDS BED (e.g. MANE/GENCODE CDS, same build); TMB territory = capture x CDS. null = capture only

    // -- Copy-number report --
    fusion_known_min_reads = 3    // single-caller known-fusion rescue needs >= this many supporting reads (+ FusionInspector confirmation when FI runs)
    cn_amp_min_cn       = null    // absolute CN at/above which a segment is labelled AMP; null = no AMP label (GAIN only)
    msi_min_sites       = 50      // MSI status reported only with >= this many evaluable sites (else NA_LOW_SITES)
    arm_bed             = null    // chromosome-arm BED (chr,start,end,arm e.g. 1p), same build; null = no arm table
    arm_call_min_frac   = 0.5     // arm called LOSS/GAIN when >= this fraction of its covered bp differs from ploidy baseline


    // -- MSI classification --
    classify_msi = true    // master toggle: run CLASSIFY_MSI
    msi_cutoff   = 20      // MSI score % threshold for MSI-H (MSIsensor-pro default; tumor-type dependent)

    // -- MAF generation --
    generate_maf = true    // master toggle: run VCF2MAF

    // -- Run manifest --
    write_manifest    = false    // master toggle: produce run_manifest.tsv
    manifest_checksum = 'none'   // 'none' (size only) | 'header' (BAM header md5) | 'full' (whole-file md5)

    // -- Mutational signatures (SigProfilerAssignment) --
    mutational_signatures = false      // master toggle: run MUTATIONAL_SIGNATURES
    sig_genome_build      = 'GRCh38'   // COSMIC reference genome build
    sig_cosmic_version    = 3.6        // COSMIC signature version
    sig_exome             = true       // use exome-renormalized COSMIC signatures (WES)
    sig_min_snv           = 50         // minimum SNVs to attempt signature assignment

    // -- Variant pre-classification (NOT a final clinical tier) --
    classify_variants  = true       // master toggle: run CLASSIFY_VARIANTS
    consolidate_somatic_reports = true     // build one sectioned TSV per patient (SNV/indel+CNV+LOH+SV+MSI+TMB)
    cosmic_cgc_tsv     = null       // path to Cosmic_CancerGeneCensus_v101_GRCh38.tsv.gz
    classify_af_field  = 'MAX_AF'   // VEP CSQ population-AF field for the common-variant filter
    classify_common_af = 0.01       // AF above this => LIKELY_BENIGN (population-common)
    cosmic_recurrence_min = 10      // COSMIC count >= this lifts a CGC-gene VUS to ONCOGENIC_MODERATE

    // -- Annotation --------------------------------------------
    vep_cache_version  = 115      // must match the release under vep_cache_dir/homo_sapiens/<ver>_GRCh38/
    vep_cache_dir      = null
    vep_plugins_dir    = null
    clinvar_vcf        = null
    cosmic_vcf         = null   // COSMIC Genome Screen Mutants VCF (GRCh38), bgzipped+tabix
    clinvar_min_stars  = 1   // min ClinVar review stars to trust a P/LP or B/LB assertion; 0 disables gating

    //// -- Phase 4: FACETS (LOH + allele-specific CN + purity/ploidy) --
    //facets_snps             = null   // polymorphic-SNP VCF (use reconciled dbSNP); LOH/purity skipped if null
    //facets_cval_preprocess  = 25     // segmentation cval for the purity pass
    //facets_cval_highsens    = 150    // segmentation cval for the high-sensitivity pass
    //facets_min_normal_depth = 25     // min read depth in the normal at a SNP site

    // -- Tool-specific resources -------------------------------
    verifybamid_db     = null     // VerifyBamID2 resource bundle directory
    verifybamid_svd    = 'hgdp.100k.b38.vcf.gz.dat'  // SVD prefix inside verifybamid_db; WES: use the bundle's exome resource
    cnvkit_pon         = null     // CNVkit panel of normals .cnn

    // -- Germline CNN variant filtering resources --------------
    hapmap             = null     // HapMap 3.3 sites VCF
    omni               = null     // 1000G Omni 2.5 sites VCF
    thousandg_snps     = null     // 1000G high-confidence SNPs VCF


    msisensor_list         = null    // Pre-scanned microsatellite site list

    // -- Germline Phase 1: SV/CNV annotation + consolidated report -
    consolidate_germline_reports = true  // build one sectioned TSV per sample (SNV/indel+SV+CNV+ROH)
    annotsv_dir                  = null   // AnnotSV annotation-DB dir (REQUIRED for SV/CNV annotation + germline report)
    germline_report_clin_min     = 'pathogenic'  // ClinVar CLIN_SIG substring kept in the report SNV section (case-insensitive)

    // -- Germline Phase 2: ROH (runs of homozygosity) -------------
    run_roh      = true   // Enable bcftools roh on the germline SNV/indel callset (further gated on assay + AF file below)
    roh_af_file    = null    // Tab-indexed population-AF file (+ .tbi). REQUIRED for ROH; self-estimation is disabled.
    roh_allow_wes  = false   // Override to force ROH on WES (not recommended; exome density too sparse)

    // -- assay/stage contract (RNA uses a subset of the shared stages) -----
    // start_at / stop_at accepted: mapping, metrics, variant_calling,
    // annotation, classification (markdup/bqsr are DNA-only and skipped here).

    // -- RNA references (REQUIRED for the mapping/calling stages) ----------
    gtf                = null    // gene annotation GTF (MUST match the STAR index)
    ctat_lib           = null    // STAR-Fusion / FusionInspector CTAT genome library dir
    star_index         = null    // STAR index dir; if null + shared mode, defaults to
                                 //   ${ctat_lib}/ref_genome.fa.star.idx (kickstart consistency)
    refflat            = null    // Picard CollectRnaSeqMetrics refFlat (optional; QC)
    rrna_interval_list = null    // Picard rRNA interval_list (optional; QC %rRNA)

    // -- Arriba resources (blacklist strongly recommended for precision) --
    arriba_blacklist       = null
    arriba_known_fusions   = null
    arriba_protein_domains = null

    // -- FusionCatcher DB (large; enables caller 3) -----------------------
    fusioncatcher_db   = null

    // -- Known-fusion catalog for the single-caller rescue + tiering ------
    //   TSV of oncogenic gene pairs (any of: 'GENEA<TAB>GENEB', 'GENEA--GENEB',
    //   'GENEA,GENEB'); e.g. derived from Mitelman / COSMIC fusions / FusionGDB.
    known_fusions_tsv  = null
    // cosmic_cgc_tsv is already defined in the base config (reused for gene roles).

    // -- Caller toggles (ensemble; mirror the somatic use_* pattern) ------
    use_arriba          = true
    use_starfusion      = true
    use_fusioncatcher   = false   // opt-in: ~24 h/sample, own aligners + Ensembl DB (symbols differ from GENCODE callers)
    use_fusioninspector = true

    // -- Efficiency / behaviour switches ----------------------------------
    rna_shared_star        = false    // ONE STAR run feeds Arriba + STAR-Fusion kickstart
    rna_cram_convert       = false    // archive the STAR BAM as CRAM (disk saving)
    fusioncatcher_allow_se = false   // FusionCatcher needs SE reads >130 bp; off by default
    rna_strandedness       = 'auto'  // arriba: auto|yes|no|reverse|forward ; picard maps reverse/forward-stranded

    // -- STAR tuning -------------------------------------------------------
    star_twopass            = true   // 2-pass improves novel-junction (breakpoint) recall
    star_sjdb_overhang      = 250    // Arriba-recommended safe universal value
    star_chim_segment_min   = 10     // Arriba/STAR-Fusion default
    star_chim_multimap_nmax = 0      // >0 (new detection) ONLY valid in separate-STAR mode
    star_sa_index_nbases    = null   // only override for small/custom references

    // -- Consensus tuning --------------------------------------------------
    fusion_min_callers      = 2      // N-of-M: keep fusions seen by >= N callers
    fusion_readthrough_kb   = 200    // same-chrom within this distance - flag read-through
    
    // -- LSF queue names (override per cluster) ----------------
    lsf_queue_short    = 'short'
    lsf_queue_medium   = 'medium'
    lsf_queue_high     = 'high'
    lsf_queue_long     = 'long'
    //   Hard RUNLIMIT (hours) of short/medium; long is bounded by resourceLimits.time.
    //   A task goes to the smallest queue whose cap >= its requested time (time * attempt).
    //   Single-queue cluster: set all queue names to that queue.
    lsf_queue_short_max_h  = 3
    lsf_queue_medium_max_h = 24
    lsf_project        = null     // LSF project/account for accounting (-P flag)


    // -- Singularity bind paths (list of dirs containers must see) -
    bind_paths         = null     // e.g. ['/home/groups/g/u', '/scratch/groups/g/u']

    // -- Container image filenames (set versioned .sif names HERE) -
    // These files live inside container_dir. Update to the versioned names
    // from your container README - they change per pipeline release, not per
    // run, so they live here rather than in project.config.
    container_align       = 'bwa_samtools_fastp_fgbio_bcftools.sif'        // fastp + bwa-mem2 + samtools
    container_gatk        = 'gatk.sif'                       // all GATK processes
    container_qc          = 'multiqc_mosdepth_verifybam2.sif'
    container_manta       = 'manta.sif'                      // Manta 
    container_strelka     = 'strelka2.sif'                   // Strelka2
    container_strelka_af  = 'strelka_tag_af.sif'             // Strelka2 AF manipulation
    container_muse        = 'muse_bcftools.sif'              // MUSE
    container_varscan     = 'varscan.sif'                    // VARSCAN
    container_deepvariant = 'deepvar_freebayes.sif'          // DeepVariant + FreeBayes
    container_msisensor   = 'msisensorpro.sif'
    container_annotation  = 'bcftool_cnvkit_vep_snpeff.sif'  // bcftools + CNVkit + VEP
    container_annotsv     = 'annotsv.sif'                    // AnnotSV (germline SV/CNV annotation)
    container_sequenza    = 'sequenza.sif'                   // Phase 4: purity/ploidy/LOH
    container_vcf2maf     = 'vcf2maf.sif'                    // VCF2MAF conversion

    // -- Phases 2-5 scaffolding (images added as each phase lands) -
    container_somalier    = 'somalier.sif'                   // Phase 3: sample-swap check
    container_signatures  = 'sigprofiler.sif'                // Phase 4: mutational signatures + TMB
    //container_purecn      = 'purecn_facets.sif'              // Phase 4: purity/ploidy/LOH
    //container_facets      = 'facets.sif'                     // Phase 4: FACETS snp-pileup + facets R

    // -- RNA Container image filenames (versioned .sif; live in container_dir) -
    container_star          = 'star_samtools.sif'   // STAR + samtools
    container_arriba        = 'arriba.sif'          // Arriba + its draw script
    container_starfusion    = 'starfusion_fusioninspector_ctat.sif'      // STAR-Fusion + FusionInspector + CTAT utils
    container_fusioncatcher = 'fusioncatcher.sif'   // FusionCatcher
}

// -- Work directory --------------------------------------------
// STABLE work dir (NOT keyed on sessionId) so `-resume` reliably finds prior
// task outputs across runs. Keep it on fast/scratch FS. Use one dir per cohort;
// run sequentially (a shared workDir means concurrent independent runs could
// collide - launch separate cohorts in separate work_root dirs if needed).
workDir = "${params.work_root}/nf_work"


// -- Executor: IBM Spectrum LSF --------------------------------
executor {
    name            = 'lsf'
    perJobMemLimit  = true        // Required: passes -M to bsub
    perTaskReserve  = false
    submitRateLimit = params.lsf_submit_rate   // tune for cohort scale (default 50/1min)
    queueSize       = params.lsf_queue_size     // tune for cohort scale (default 500)
    exitReadTimeout = '10 min'    // Wait for LSF to report job status
    pollInterval    = '30 sec'
}

// -- Node-local temp for all jobs ------------------------------
// GATK --tmp-dir reads $TMPDIR. Pin to node-local /tmp (override
// to /lscratch or /scratch/local/$LSB_JOBID if your cluster uses that).
env {
    TMPDIR = '/tmp'
}

// -- Process defaults ------------------------------------------
process {
    // scratch=true: temp/working files - node-local scratch, protecting
    // the shared FS. Inputs symlinked (stageInMode default), not copied.
    scratch = false

    // Retry on OOM / LSF kill (137 OOM, 140 MEMLIMIT, 143 RUNLIMIT)
    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    // HARD CAP - no task may request beyond this even after retry doubling.
    // Sized to the COMMON node (cdragon: 28 cores / 188 GB) so every job lands
    // on the ~400-node standard pool and never waits for the scarce 80-core
    // edragon / 32-core gdragon big nodes. 240h = 'long' queue cap.
    resourceLimits = [ cpus: 28, memory: 180.GB, time: 240.h ]

    // LSF submit: -M/rusage/select/span/-n are emitted by the LSF executor
    // (perJobMemLimit). Pass ONLY what it cannot infer.
    clusterOptions = { params.lsf_project ? "-P ${params.lsf_project}" : '' }

    // Queue derived from the requested walltime of THIS attempt, so a retry whose
    // time*attempt outgrows a queue's hard RUNLIMIT is promoted to the next queue
    // instead of being rejected by bsub (exit 255 - not retryable). Names and caps
    // are params (lsf_queue_*, lsf_queue_*_max_h). No time set -> medium.
    queue = {
        def t  = task.time
        def ms = t ? t.toMillis() : null
        def hr = 3600000d
        !t                                                   ? params.lsf_queue_medium :
        ms <= (params.lsf_queue_short_max_h  as double) * hr ? params.lsf_queue_short  :
        ms <= (params.lsf_queue_medium_max_h as double) * hr ? params.lsf_queue_medium :
                                                               params.lsf_queue_long
    }

    // ------------------------------------------------------------
    //  RESOURCE LABELS - numbers grounded in nf-core/sarek base.config,
    //  capped to a 28-core/188GB node. Queue chosen so base_time - 3
    //  (maxRetries+1) fits the cap: short<180min, medium=24h, long=240h.
    //  Principle: request the MINIMUM each step needs - schedules fast.
    // ------------------------------------------------------------
    //  Queue caps: short=180min(3h), medium=1440min(24h), long=14400min(240h).
    //  With maxRetries=2, max time = base - 3, so base must satisfy:
    //    short:  base - 60min   (60-3 = 180)
    //    medium: base - 8h      (8-3  = 24h)
    //    long:   base - 80h
    //  Rule: size time to the REAL job, then pick the SMALLEST fitting queue.
    // ------------------------------------------------------------

    withLabel: 'process_tiny' {        // tabix/bgzip/index: seconds-minutes
        cpus   = 1
        memory = { 2.GB   * task.attempt }
        time   = { 20.min * task.attempt }   // 20-3=60min - short
    }

    withLabel: 'process_low' {         // BQSR, samtools_stats, annotate: minutes
        cpus   = 2
        memory = { 8.GB   * task.attempt }
        time   = { 45.min * task.attempt }   // 45-3=135min < short 180min (margin)
    }

    withLabel: 'process_qc' {          // mosdepth, metrics (HsMetrics)
        cpus   = 4
        // memory AND time intentionally NOT set here: METRICS sizes both in its
        // process body (deep tumors need ~150 GB / ~3+ h vs ~16 GB / ~1 h for
        // normals; a label setting would override the body). MOSDEPTH gets its
        // own small allocation via withName below.
    }

    // MOSDEPTH is the light process_qc mate (~2 GB RSS, minutes); size it directly
    // so removing memory/time from the process_qc label doesn't leave it unset.
    withName: 'MOSDEPTH' {
        memory = { 8.GB   * task.attempt }
        time   = { 20.min * task.attempt }
    }

    withLabel: 'process_medium' {      // MultiQC, FACETS, CNVkit, merges: 1-3h
        cpus   = 6
        memory = { 16.GB  * task.attempt }
        time   = { 4.h    * task.attempt }   // 4-3=12h < medium 24h
    }

    withLabel: 'process_markdup' {     // MarkDuplicates / UMI merge
        cpus   = 6
        // Trace: deep tumor peaked ~96 GB RSS; a "normal" sample used 56 GB on
        // 16 GB input - RSS does NOT track input size here (duplication/UMI-family
        // structure drives it), so a size-aware closure would be unreliable. Flat
        // 110 GB covers the deepest observed and lets every sample pass attempt 1
        // (no fail->retry->succeed, the #6884 trigger). Over-provisions normals;
        // if that costs too much concurrency, two-tier by meta.type in the body.
        memory = { 110.GB * task.attempt }
        time   = { 6.h    * task.attempt }   // deep markdup ran 1h44m; ample margin
    }

    withLabel: 'process_high_cpu' {    // bwa-mem2 alignment, CPU-bound
        cpus   = 14                    // fits a 28-core node with headroom
        // Trace: RSS ~28 GB flat across ALL samples incl. deep (bwa-mem2 is
        // index-bound - memory does NOT scale with coverage). 64 GB over-reserved
        // ~2.3x and hurt node packing; 48 GB covers the index + streaming buffers
        // with margin. Time scales with reads (deep chunk ran ~1h34m < 4h base).
        memory = { 48.GB  * task.attempt }
        time   = { 4.h    * task.attempt }
        scratch = false
    }

    withLabel: 'process_high_memory' { // fgbio UMI consensus: memory-heavy, 2-6h
        cpus   = 8
        memory = { 150.GB  * task.attempt }
        time   = { 25.h    * task.attempt }   // 25-3=75h > high 24h - long
        scratch = false
    }

    withLabel: 'process_variant' {     // Mutect2/Manta: variable, can be long
        cpus   = 8
        memory = { 64.GB  * task.attempt }
        time   = { 6.h   * task.attempt }   // 7-3=36h < medium - medium
    }

    withLabel: 'process_strelka' {
        cpus   = 8
        memory = { 64.GB  * task.attempt }
        time   = { 4.h * task.attempt }
        scratch = false
    }

    withLabel: 'process_long' {        // gCNV model/caller: genuinely long
        cpus   = 8
        memory = { 64.GB  * task.attempt }
        time   = { 80.h   * task.attempt }   // 40-3=120h < long 240h
    }

    // -- new resource labels (fit the 28c/180G/240h cap; escalate on retry) -
    withLabel: 'process_star' {          // STAR align / index - genome-load bound
        cpus   = 12
        memory = { 64.GB * task.attempt }
        time   = { 6.h   * task.attempt }
        scratch = false
    }
    withLabel: 'process_arriba' {        // Arriba - light, annotation-bound
        cpus   = 8
        memory = { 40.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: 'process_fusioncatcher' { // FusionCatcher - slow, own aligners
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }   // 24-2 = 48h < long 240h (maxRetries 1)
    }
    withLabel: 'process_fusion_validate' { // FusionInspector - STAR-backed re-align
        cpus   = 8
        memory = { 40.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel: 'process_ploidy' {
        cpus   = 8
        memory = { 128.GB * task.attempt }
        time   = { 25.h   * task.attempt }
    }

    withName: MSISENSOR_PRO {
        beforeScript = 'ulimit -n 65535'
    }

    // -- GATK (shared image) -----------------------------------
    withName: 'METRICS|BASE_RECALIBRATOR|APPLY_BQSR|HAPLOTYPECALLER|MERGE_GVCFS|MUTECT2|MERGE_MUTECT2|GENOTYPE_GVCFS|NV_SCORE_VARIANTS|FILTER_VARIANT_TRANCHES|REBLOCK_GVCF|GNARLY_GENOTYPER|GENOMICSDB_IMPORT|GENOTYPE_GVCFS_JOINT|MERGE_COHORT_VCF|VQSR_SNP|VQSR_INDEL|APPLY_VQSR_SNP|APPLY_VQSR_INDEL|SPLIT_COHORT_VCF|GATK_COLLECT_READ_COUNTS|GATK_PLOIDY_MODEL|GATK_GCNV_CALLER|GATK_GCNV_POSTPROCESS|MERGE_AND_MARKDUP_UMI|GETPILEUPSUMMARIES|CALCULATE_CONTAMINATION|LEARN_READ_ORIENTATION_MODEL' {
        container = "${params.container_dir}/${params.container_gatk}"
    }

    // -- samtools (3 processes) --------------------------------
    withName: 'PREPROCESS_AND_ALIGN_DNA|ALIGN_DNA_UMI|MERGE_AND_MARK_DUPLICATES|CRAM_CONVERT|SAMTOOLS_STATS|SAMTOOLS_TABIX_BED|MERGE_AND_CONSENSUS' {
        container = "${params.container_dir}/${params.container_align}"
    }
    withName: 'MULTIQC|MOSDEPTH|VERIFYBAMID2' {
        container = "${params.container_dir}/${params.container_qc}"
    }
    // -- somalier (sample-swap detection) ----------------------
    withName: 'SOMALIER_EXTRACT|SOMALIER_RELATE' {
        container = "${params.container_dir}/${params.container_somalier}"
    }
    // -- FACETS (LOH + allele-specific CN + purity/ploidy) -----
    //withName: 'FACETS' {
    //    container = "${params.container_dir}/${params.container_facets}"
    //}

    // -- MUSE -----
    withName: 'MUSE_CALL|MUSE_SUMP' {
        container = "${params.container_dir}/${params.container_muse}"
    }
    // -- Manta (2 processes, identical resources - fully merged) -
    withName: 'MANTA|MANTA_GERMLINE' {
        container = "${params.container_dir}/${params.container_manta}"
    }
    // -- Strelka-2 -
    withName: 'STRELKA2' {
        container = "${params.container_dir}/${params.container_strelka}"
    }
    // -- VARSCAN -
    withName: 'VARSCAN' {
        container = "${params.container_dir}/${params.container_varscan}"
    }
    withName: 'TAG_STRELKA_AF|TAG_MUSE_AF|TAG_VARSCAN_AF' {
        container = "${params.container_dir}/${params.container_strelka_af}"
    }
    withName: 'DEEPVARIANT|FREEBAYES' {
        container = "${params.container_dir}/${params.container_deepvariant}"
    }
    // -- SEQUENZA (LOH + allele-specific CN + purity/ploidy) -----
    // sequenza.sif has R
    withName: 'SEQUENZA|SEQUENZA_GENE_LOH|MSISENSOR_GENE_MAP' {
        container = "${params.container_dir}/${params.container_sequenza}"
    }
    // -- Single-process containers -----------------------------
    withName: 'MSISENSOR_PRO|CLASSIFY_MSI' {
        container = "${params.container_dir}/${params.container_msisensor}"
    }
    withName: MUTATIONAL_SIGNATURES {
        container = "${params.container_dir}/${params.container_signatures}"
    }
    // -- VCF2MAF -
    withName: 'VCF2MAF' {                           
        container = "${params.container_dir}/${params.container_vcf2maf}"
    }
    withName: 'PREFLIGHT_REFERENCES|COMPUTE_TMB|ENSEMBLE_CONSENSUS|ANNOTATE_VCF|CNVKIT|FILTER_SOMATIC_VCF|CLASSIFY_VARIANTS|CONSOLIDATE_PATIENT_REPORT|BCFTOOLS_ROH|CONSOLIDATE_GERMLINE_REPORT' {
        container = "${params.container_dir}/${params.container_annotation}"
    }
    withName: 'ANNOTATE_SV_MANTA|ANNOTATE_SV_GCNV|ANNOTATE_SV_SOMATIC' {
        container = "${params.container_dir}/${params.container_annotsv}"
    }
    withName: 'STAR_ALIGN|STAR_GENOME_INDEX' {
        container = "${params.container_dir}/${params.container_star}"
    }
    withName: 'ARRIBA' {
        container = "${params.container_dir}/${params.container_arriba}"
    }
    withName: 'STARFUSION|FUSIONINSPECTOR' {
        container = "${params.container_dir}/${params.container_starfusion}"
    }
    withName: 'FUSIONCATCHER' {
        container = "${params.container_dir}/${params.container_fusioncatcher}"
    }
    // reuse existing images
    withName: 'RNASEQ_METRICS' {
        container = "${params.container_dir}/${params.container_gatk}"
    }
    withName: 'FUSION_CONSENSUS|FILTER_FUSION_CANDIDATES|ANNOTATE_FUSIONS|CONSOLIDATE_FUSION_REPORT' {
        container = "${params.container_dir}/${params.container_annotation}"
    }
}

// -- Container engine ------------------------------------------
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${params.container_dir}"
    // runOptions: bind mount any cluster-specific paths as needed
    runOptions = (params.bind_paths ?: []).collect { "--bind ${it}" }.join(' ') + ' --bind /tmp'
}

// -- Profiles -------------------------------------------------
profiles {

    // -- Clinical profile: accuracy + auditability -------------
    clinical {
        params.bqsr             = true
        params.germline_caller  = 'deepvariant'
        process {
            cache = 'lenient'
            withLabel: 'process_high_cpu' { time = { 16.h * task.attempt } }
            withLabel: 'process_variant'  { time = { 16.h * task.attempt } }
        }
    }

    // -- Production profile: throughput ------------------------
    production {
        params.bqsr             = false
        params.germline_caller  = 'haplotypecaller'
    }

    // -- Test profile: minimal resources for CI ----------------
    test {
        params.bqsr             = false
        params.germline_caller  = 'haplotypecaller'
        params.start_at         = 'mapping'
        params.stop_at          = 'markdup'

        executor {
            name = 'local'   // Run locally in CI, not LSF
        }

        process {
            withLabel: 'process_high_cpu' {
                cpus   = 4
                memory = '8 GB'
                time   = { 1.h * task.attempt }
            }
            withLabel: 'process_high_memory' {
                cpus   = 4
                memory = '8 GB'
                time   = { 1.h * task.attempt }
            }
        }
    }

    // -- OPT-IN: big-node lane for ultra-deep samples --------------
    //   Use ONLY if your deepest samples need more than the 180 GB common-pool
    //   cap (i.e. the size-aware sizing keeps hitting big_mem_ceiling_gb and
    //   still OOMs). Enable with: -profile production,bignode  (after confirming
    //   with your LSF admin that routing to the scarce edragon/gdragon big nodes
    //   is acceptable). This widens the hard cap and lifts the per-task ceiling
    //   so the size-aware closures in components can actually request big memory;
    //   it also pins the heavy labels to the long/big-node queue.
    //   TRADE-OFF: these jobs leave the ~400-node standard pool and may queue
    //   behind the handful of big nodes - slower to start, but they complete
    //   instead of failing all retries. CALIBRATE the numbers to your big nodes.
    bignode {
        params.big_mem_ceiling_gb = 280     // let size-aware closures climb past 180

        process {
            resourceLimits = [ cpus: 40, memory: 300.GB, time: 30.h ]
            withLabel: 'process_high_cpu' { queue = params.lsf_queue_long }
            withLabel: 'process_variant'  { queue = params.lsf_queue_long }
            withLabel: 'process_markdup'  { queue = params.lsf_queue_long }
            withLabel: 'process_high_memory' { queue = params.lsf_queue_long }
        }
    }
}

// -- Cache strategy --------------------------------------------
// lenient: files matched by name+size+lastModified (faster)
// deep:    files matched by MD5 checksum (more robust, slower)
// Use 'lenient' in production (GPFS mtime is reliable).
// Use 'deep' for clinical audit-grade reproducibility.
process.cache = 'lenient'

// -- Report + trace --------------------------------------------
report {
    enabled  = true
    file     = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

trace {
    enabled  = true
    file     = "${params.outdir}/pipeline_trace.txt"
    fields   = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,%cpu,%mem,rss,vmem,rchar,wchar,queue'
    overwrite = true
}

// timeline + dag are OFF by default: at cohort scale (100k+ tasks) the
// timeline HTML grows to hundreds of MB (can OOM a browser) and the DAG
// is unreadable, while both add real submission-time rendering cost. The
// trace TSV above is cheap and is the artifact you actually want for
// right-sizing (see peak_rss/vmem columns). Re-enable for small debug runs
// with --detailed_reports.
timeline {
    enabled  = params.detailed_reports
    file     = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

dag {
    enabled  = params.detailed_reports
    file     = "${params.outdir}/pipeline_dag.html"
    overwrite = true
}
