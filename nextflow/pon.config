// ============================================================
//  pon.config  -  Additive Panel-of-Normals (PON) build configuration
//
//  Run once (or occasionally, when the normal cohort changes):
//    nextflow run main_pon.nf -c project.config -c pon.config \
//        -profile production --pon_samplesheet normals.csv
//
//  Reuses container_gatk and the base process_variant/process_medium labels
//  already defined in nextflow.config; only adds what's new for PON building.
// ============================================================

params {
    pon_samplesheet          = null   // CSV: sample_id,bam,bai (normal samples only)
    pon_genomicsdb_batch_size = 15    // GenomicsDBImport --batch-size (memory control for large cohorts)
    pon_min_sample_count      = 2     // CreateSomaticPanelOfNormals --min-sample-count (GATK default)
    pipeline_root      = null
    work_root          = null
    ref_index_dir      = null   // Directory containing all bwa-mem2 index files + ref FASTA
    container_dir      = null
    samplesheet        = null
    ref_fasta          = null
    ref_fai            = null
    ref_dict           = null
    outdir             = null
    scatter_intervals  = null   // Directory of N interval files for scatter
    germline_resource  = null     // gnomAD AF-only VCF (Mutect2)

    container_gatk     = 'gatk.sif'                       // all GATK processes


}

process {

    withLabel: 'process_genomicsdb' {
        cpus    = 4
        memory  = { 124.GB * task.attempt }
        time    = { 25.h  * task.attempt }
        queue   = params.lsf_queue_long
        scratch = false
    }


    withName: 'PON_MUTECT2|PON_MERGE_NORMAL|PON_GENOMICSDB_IMPORT|PON_CREATE_SHARD|PON_MERGE_FINAL' {
        container = "${params.container_dir}/${params.container_gatk}"
    }
}
