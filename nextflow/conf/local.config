// ============================================================
//  conf/local.config  -  single-machine execution profile
//  Use: nextflow run main.nf -params-file <params.yaml> -profile local
//
//  EDIT the three numbers below to your machine. resourceLimits caps
//  every task's request (including retry escalation) to what the
//  machine has, so labels sized for the cluster (e.g. 110 GB markdup)
//  are clamped instead of failing to schedule.
//
//  Guidance: the demonstration dataset runs within 16 CPUs / 64 GB.
//  A full-depth WES pair needs >= 128 GB (duplicate marking and
//  Picard metrics on deep tumours are the memory peaks); STAR and
//  STAR-Fusion need >= 40 GB for the human genome index.
// ============================================================

executor {
    name   = 'local'
    cpus   = 16          // EDIT: CPUs Nextflow may use in total
    memory = '64 GB'     // EDIT: memory Nextflow may use in total
}

process {
    resourceLimits = [ cpus: 16, memory: 64.GB, time: 240.h ]   // EDIT: match executor
    clusterOptions = ''  // no scheduler
}
