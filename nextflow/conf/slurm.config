// ============================================================
//  conf/slurm.config  -  SLURM execution profile
//  Use: nextflow run main.nf -params-file <params.yaml> -profile slurm
//
//  The resource labels in nextflow.config (cpus / memory / time per
//  process_* label) are scheduler-independent and are reused as-is.
//  Only the scheduler-specific parts are replaced here.
//
//  Partitions: the labels pick a queue from params.lsf_queue_short /
//  _medium / _high / _long. On SLURM set those four params to your
//  PARTITION names in the params YAML, e.g.
//      lsf_queue_short : 'short'
//      lsf_queue_medium: 'normal'
//      lsf_queue_high  : 'normal'
//      lsf_queue_long  : 'long'
//  and check each label's time (nextflow.config, x task.attempt on retry)
//  fits the partition's wall-time limit.
//  Account: params.lsf_project is passed as --account.
// ============================================================

executor {
    name            = 'slurm'
    queueSize       = params.lsf_queue_size
    submitRateLimit = params.lsf_submit_rate
    pollInterval    = '30 sec'
    exitReadTimeout = '10 min'
}

process {
    // replace the LSF '-P <project>' option with the SLURM equivalent
    clusterOptions = { params.lsf_project ? "--account=${params.lsf_project}" : '' }

    // SLURM's OOM kill exits 137 (same as LSF); time-limit kill exits 140 on
    // some sites. The base errorStrategy already retries [137, 140, 143].
}
